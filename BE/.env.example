NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional: use this on hosted platforms. If set, DB_* values can be ignored.
DATABASE_URL=

DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mendingmana_db
DB_SSL=false

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=1d

# Optional seed users
SEED_ADMIN_NAME=Administrator MendingMana
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@mendingmana.local
SEED_ADMIN_PASSWORD=Admin12345!

SEED_MEMBER_NAME=Member MendingMana
SEED_MEMBER_USERNAME=member
SEED_MEMBER_EMAIL=member@mendingmana.local
SEED_MEMBER_PASSWORD=Member12345!